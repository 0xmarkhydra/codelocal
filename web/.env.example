# Server-only origin for the Go CodeLocal backend used by direct Next canary rewrites.
# Production browser APIs stay on the public Go gateway; Go proxies presentation pages to Next instead.
# This must resolve to the Go service itself, NOT the public Next.js origin, or canary rewrites can loop.
# Do not rename this to NEXT_PUBLIC_*; browser code must not receive backend secrets or privileged configuration.
CODELOCAL_BACKEND_URL=http://127.0.0.1:3333
