{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/docker/pool-api.Dockerfile",
    "watchPatterns": [
      "cmd/codelocal-pool/**",
      "internal/aipool/**",
      "go.mod",
      "go.sum",
      "deploy/docker/pool-api.Dockerfile",
      "railway.pool-api.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
