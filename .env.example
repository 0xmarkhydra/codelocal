# ===== Local client =====
PROJECT_ROOT=/Users/yourname/Projects/example-project
SERVER_URL=wss://codex-mcp-production.up.railway.app/client
DEVICE_TOKEN=replace-me

# Stable identifiers used for multi-device/workspace routing.
CODELOCAL_DEVICE_ID=macbook-pro
CODELOCAL_WORKSPACE_ID=example-project
CODELOCAL_WORKSPACE_NAME=Example Project

# Shell/process behavior.
CODELOCAL_ALLOW_SHELL=1
CODELOCAL_ALLOW_DANGEROUS=0
CODELOCAL_APPROVAL_MODE=prompt
CODELOCAL_MIRROR_PROCESS_OUTPUT=1
CODELOCAL_LOG_LEVEL=info

# ===== Railway/server =====
HOST=0.0.0.0
PORT=3333
PUBLIC_BASE_URL=https://your-service.example.com
DEVICE_TOKEN=replace-me
MCP_USER_PASSWORD=replace-me
MCP_AUTH_SECRET=replace-with-long-random-secret
TOOL_TIMEOUT_MS=180000
