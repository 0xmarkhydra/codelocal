{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/docker/penpot-frontend.Dockerfile",
    "watchPatterns": [
      "deploy/docker/penpot-frontend.Dockerfile",
      "deploy/penpot/**",
      "railway.penpot-frontend.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
