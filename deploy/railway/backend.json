{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "cmd/codelocal-cloud/**",
      "internal/clientupdate/**",
      "internal/cloud/**",
      "internal/cloudserver/**",
      "internal/deviceauth/**",
      "internal/gateway/**",
      "internal/learnedskills/**",
      "internal/localfs/**",
      "internal/lsp/**",
      "internal/mailer/**",
      "internal/mcpgateway/**",
      "internal/memory/**",
      "internal/oauth/**",
      "internal/penpot/**",
      "internal/orchestration/**",
      "internal/plugins/**",
      "internal/project/**",
      "internal/projectbrain/**",
      "internal/projectidentity/**",
      "internal/protocol/**",
      "internal/repository/**",
      "internal/security/**",
      "internal/social/**",
      "internal/state/**",
      "internal/taskstate/**",
      "internal/usage/**",
      "internal/version/**",
      "internal/webauth/**",
      "internal/webutil/**",
      "assets/**",
      "go.mod",
      "go.sum",
      "Dockerfile",
      "deploy/railway/backend.json"
    ]
  },
  "deploy": {
    "startCommand": "/app/codelocal-cloud",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
