location /mcp/ws {
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    access_log off;
    error_log /dev/null;
    set $mcp_ws_backend $PENPOT_MCP_URI/api/v1/penpot/ws$is_args$args;
    proxy_pass $mcp_ws_backend;
    proxy_http_version 1.1;
}

location /mcp/stream {
    set $mcp_stream_backend $PENPOT_MCP_URI/api/v1/penpot/mcp$is_args$args;
    proxy_pass $mcp_stream_backend;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 600s;
}

location /mcp/sse {
    # Legacy SSE carries unsigned session IDs inside event bodies. Hosted
    # CodeLocal uses Streamable HTTP; never expose an unguarded fallback.
    return 410;
}
