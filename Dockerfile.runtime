# syntax=docker/dockerfile:1
FROM golang:1.25-bookworm AS build
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/codelocal-cloud-runtime ./cmd/codelocal-cloud-runtime

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates bash git ripgrep curl \
  && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --create-home codelocal \
  && mkdir -p /workspace /home/codelocal/.codelocal \
  && chown -R codelocal:codelocal /workspace /home/codelocal
COPY --from=build /out/codelocal-cloud-runtime /usr/local/bin/codelocal-cloud-runtime
USER codelocal
WORKDIR /workspace
ENV CODELOCAL_STATE_DIR=/home/codelocal/.codelocal \
    CODELOCAL_WORKSPACE_PATH=/workspace \
    HOME=/home/codelocal
ENTRYPOINT ["/usr/local/bin/codelocal-cloud-runtime"]
