{
  "name": "codex-mcp",
  "version": "1.2.0-dev.0",
  "private": true,
  "type": "module",
  "description": "CodeLocal smart MCP development branch with native workspace events, incremental code intelligence, per-root LSP routing, context ranking, sandboxed execution and auditable local actions.",
  "bin": {
    "codelocal": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server-v2.ts",
    "build": "tsc --outDir dist",
    "prepare": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/server-v2.js",
    "client": "npm run build --silent && node dist/client-entry-v2.js",
    "doctor": "npm run build --silent && node dist/cli.js doctor",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test dist/__tests__/*.test.js",
    "ci": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@parcel/watcher": "^2.6.0",
    "chokidar": "^4.0.3",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "typescript": "^5.9.2",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5"
  },
  "engines": { "node": ">=20" }
}
